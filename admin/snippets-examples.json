    "location": "header",
    "priority": 5,
    "active": true,
    "code": "/* Kuwait Store Custom Colors */\n:root {\n  --kuwait-green: #007A3D;\n  --kuwait-red: #CE1126;\n  --kuwait-black: #000000;\n  --kuwait-white: #FFFFFF;\n}\n\nbody {\n  font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif;\n}\n\n.btn-primary {\n  background: var(--kuwait-green) !important;\n  border-color: var(--kuwait-green) !important;\n}\n\n.btn-primary:hover {\n  background: #005a2d !important;\n  border-color: #005a2d !important;\n}",
