  {
    "id": 5,
    "name": "Smooth Scroll",
    "description": "تمرير سلس للصفحة",
    "type": "javascript",
    "location": "footer",
    "priority": 15,
    "active": true,
    "code": "// Smooth Scroll\ndocument.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  anchor.addEventListener('click', function (e) {\n    e.preventDefault();\n    const target = document.querySelector(this.getAttribute('href'));\n    if (target) {\n      target.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n    }\n  });\n});",
    "created": "2024-01-01T00:00:00.000Z",
    "modified": "2024-01-01T00:00:00.000Z"
  },
  {
    "id": 6,
    "name": "Print Styles",
    "description": "تنسيقات الطباعة",
    "type": "css",
    "location": "header",
    "priority": 5,
    "active": true,
    "code": "/* Print Styles */\n@media print {\n  .no-print,\n  header,\n  footer,\n  .sidebar,\n  button {\n    display: none !important;\n  }\n  \n  body {\n    font-size: 12pt;\n    color: #000;\n    background: #fff;\n  }\n  \n  a[href]:after {\n    content: \" (\" attr(href) \")\";\n  }\n}",
    "created": "2024-01-01T00:00:00.000Z",
    "modified": "2024-01-01T00:00:00.000Z"
  },
  {
    "id": 7,
    "name": "Cookie Consent Banner",
    "description": "إشعار ملفات تعريف الارتباط",
    "type": "html",
    "location": "footer",
    "priority": 25,
    "active": false,
    "code": "<style>\n.cookie-banner {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: rgba(0, 0, 0, 0.9);\n  color: white;\n  padding: 20px;\n  text-align: center;\n  z-index: 9999;\n  display: none;\n}\n.cookie-banner.show {\n  display: block;\n}\n.cookie-banner button {\n  background: #007A3D;\n  color: white;\n  border: none;\n  padding: 10px 20px;\n  margin: 0 10px;\n  border-radius: 5px;\n  cursor: pointer;\n}\n</style>\n\n<div id=\"cookieBanner\" class=\"cookie-banner\">\n  <p>نستخدم ملفات تعريف الارتباط لتحسين تجربتك. بالمتابعة، فإنك توافق على استخدامنا لملفات تعريف الارتباط.</p>\n  <button onclick=\"acceptCookies()\">موافق</button>\n  <button onclick=\"declineCookies()\">رفض</button>\n</div>\n\n<script>\nif (!localStorage.getItem('cookieConsent')) {\n  document.getElementById('cookieBanner').classList.add('show');\n}\n\nfunction acceptCookies() {\n  localStorage.setItem('cookieConsent', 'accepted');\n  document.getElementById('cookieBanner').classList.remove('show');\n}\n\nfunction declineCookies() {\n  localStorage.setItem('cookieConsent', 'declined');\n  document.getElementById('cookieBanner').classList.remove('show');\n}\n</script>",
    "created": "2024-01-01T00:00:00.000Z",
    "modified": "2024-01-01T00:00:00.000Z"
  },
  {
    "id": 8,
    "name": "Back to Top Button",
    "description": "زر العودة للأعلى",
    "type": "html",
    "location": "footer",
    "priority": 20,
    "active": true,
    "code": "<style>\n.back-to-top {\n  position: fixed;\n  bottom: 80px;\n  left: 20px;\n  background: #007A3D;\n  color: white;\n  width: 50px;\n  height: 50px;\n  border-radius: 50%;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.2);\n  transition: all 0.3s;\n  z-index: 999;\n}\n.back-to-top.show {\n  display: flex;\n}\n.back-to-top:hover {\n  background: #005a2d;\n  transform: translateY(-5px);\n}\n</style>\n\n<div class=\"back-to-top\" id=\"backToTop\" onclick=\"scrollToTop()\">\n  <svg width=\"24\" height=\"24\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n    <path d=\"M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z\"/>\n  </svg>\n</div>\n\n<script>\nwindow.addEventListener('scroll', function() {\n  const btn = document.getElementById('backToTop');\n  if (window.pageYOffset > 300) {\n    btn.classList.add('show');\n  } else {\n    btn.classList.remove('show');\n  }\n});\n\nfunction scrollToTop() {\n  window.scrollTo({\n    top: 0,\n    behavior: 'smooth'\n  });\n}\n</script>",
    "created": "2024-01-01T00:00:00.000Z",
    "modified": "2024-01-01T00:00:00.000Z"
  }
]
